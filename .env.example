# EventSphere Firebase Configuration
# If left blank, EventSphere automatically runs in Zero-Config Demo Mode
# with full local persistence across browser refreshes.

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=eventsphere-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eventsphere-demo
VITE_FIREBASE_STORAGE_BUCKET=eventsphere-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
